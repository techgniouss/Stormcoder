{
	"name": "mjolnir",
	"productName": "Mjolnir",
	"version": "1.0.0",
	"description": "Mjolnir — a standalone desktop AI coding workspace: multi-provider chat, Plan and Agent modes, MCP, skills and phone remote control.",
	"main": "dist/main.js",
	"license": "MIT",
	"author": "Srikanth Reddy",
	"type": "commonjs",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "node scripts/build.mjs",
		"start": "npm run build && electron .",
		"test": "npm run build:tests && node scripts/run-tests.mjs",
		"build:tests": "tsc -p tsconfig.test.json",
		"dist": "npm run build && electron-builder",
		"dist:dir": "npm run build && electron-builder --dir"
	},
	"dependencies": {
		"sql.js": "1.14.2"
	},
	"devDependencies": {
		"@fontsource-variable/public-sans": "^5.3.0",
		"@types/node": "^22.10.0",
		"@types/sql.js": "^1.4.9",
		"@types/ws": "^8.18.2",
		"electron": "^33.2.0",
		"electron-builder": "^25.1.8",
		"esbuild": "^0.24.0",
		"playwright-core": "^1.49.0",
		"typescript": "^5.7.2",
		"ws": "^8.22.0"
	}
}
