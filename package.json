{
	"name": "stormcoder",
	"productName": "Stormcoder",
	"version": "1.3.2",
	"description": "Stormcoder \u2014 a standalone desktop AI coding workspace: multi-provider chat, Plan and Agent modes, MCP, skills and phone remote control.",
	"main": "dist/main.js",
	"license": "MIT",
	"author": "Srikanth Reddy",
	"type": "commonjs",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:webview",
		"build": "node scripts/build.mjs",
		"start": "npm run build && electron .",
		"test": "npm run typecheck && npm run build && node scripts/build-tests.mjs && node scripts/run-tests.mjs && node test/e2e.mjs && xvfb-run -a node test/electron-smoke.mjs",
		"build:tests": "node scripts/build-tests.mjs",
		"dist": "npm run build && electron-builder",
		"dist:dir": "npm run build && electron-builder --dir",
		"typecheck:webview": "tsc -p tsconfig.webview.json",
		"dev:web": "npm run build && MJ_PORT=4800 node dist/dev-host.js",
		"gen": "node scripts/gen-config.mjs"
	},
	"dependencies": {
		"electron-updater": "^6.8.9",
		"sql.js": "1.14.2"
	},
	"devDependencies": {
		"@fontsource-variable/public-sans": "^5.3.0",
		"@types/node": "^22.10.0",
		"@types/sql.js": "^1.4.9",
		"@types/ws": "^8.18.2",
		"electron": "^33.2.0",
		"electron-builder": "^25.1.8",
		"esbuild": "^0.24.0",
		"playwright-core": "^1.49.0",
		"typescript": "^5.7.2",
		"ws": "^8.22.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/techgniouss/Stormcoder.git"
	},
	"homepage": "https://github.com/techgniouss/Stormcoder"
}