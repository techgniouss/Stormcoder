              "event": { "type": "string", "enum": ["PreToolUse", "PostToolUse"] },
              "matcher": { "type": "string" },
              "command": { "type": "string" },
              "timeoutMs": { "type": "number" }
            },
            "required": ["event", "command"]
          },
          "description": "%config.hooks%"
        },
        "stormcoder.guardrails.protectedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
