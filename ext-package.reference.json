{
  "name": "openvs-chat",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "icon": "build/icon.png",
  "publisher": "openvs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./out/extension",
  "enabledApiProposals": [
    "findTextInFiles",
    "contribSourceControlInputBoxMenu",
    "inlineCompletionsAdditions"
  ],
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "chat",
    "openai",
    "chatgpt",
    "claude",
    "anthropic",
    "nvidia",
    "openrouter",
    "groq",
    "mistral",
    "cloudflare",
    "kimi",
    "moonshot",
    "qwen",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat works in untrusted workspaces, but Agent mode cannot write files or run commands until you trust the workspace."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "stormcoder",
          "title": "%viewsContainers.chat.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "stormcoder": [
        {
          "type": "webview",
          "id": "stormcoder.view",
          "name": "%views.chat.name%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "stormcoder.focus",
        "title": "%commands.focus%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.newChat",
        "title": "%commands.newChat%",
        "category": "Stormcoder",
        "icon": "$(add)"
      },
      {
        "command": "stormcoder.configureProvider",
        "title": "%commands.configureProvider%",
        "category": "Stormcoder",
        "icon": "$(key)"
      },
      {
        "command": "stormcoder.openSettings",
        "title": "%commands.openSettings%",
        "category": "Stormcoder",
        "icon": "$(settings-gear)"
      },
      {
        "command": "stormcoder.signIn",
        "title": "%commands.signIn%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.clearKey",
        "title": "%commands.clearKey%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.selectProvider",
        "title": "%commands.selectProvider%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.explainSelection",
        "title": "%commands.explainSelection%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.fixSelection",
        "title": "%commands.fixSelection%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.docSelection",
        "title": "%commands.docSelection%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.optimizeSelection",
        "title": "%commands.optimizeSelection%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.generateTests",
        "title": "%commands.generateTests%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.editSelection",
        "title": "%commands.editSelection%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.mcpReconnect",
        "title": "%commands.mcpReconnect%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.mcpStatus",
        "title": "%commands.mcpStatus%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.selectSkill",
        "title": "%commands.selectSkill_cmd%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.createSkill",
        "title": "%commands.createSkill%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.mcpAdd",
        "title": "%commands.mcpAdd%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.mcpOpenConfig",
        "title": "%commands.mcpOpenConfig%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.generateCommitMessage",
        "title": "%commands.generateCommitMessage%",
        "category": "Stormcoder",
        "icon": "$(sparkle)"
      },
      {
        "command": "stormcoder.remoteEnable",
        "title": "%commands.remoteEnable%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.remoteStatus",
        "title": "%commands.remoteStatus%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.remoteDeployRelay",
        "title": "%commands.remoteDeployRelay%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.remoteInstallCloudflared",
        "title": "%commands.remoteInstallCloudflared%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.remoteSetTunnel",
        "title": "%commands.remoteSetTunnel%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.completions.toggle",
        "title": "%commands.completionsToggle%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.completions.trigger",
        "title": "%commands.completionsTrigger%",
        "category": "Stormcoder"
      },
      {
        "command": "stormcoder.completions.showStats",
        "title": "%commands.completionsShowStats%",
        "category": "Stormcoder"
      }
    ],
    "submenus": [
      {
        "id": "stormcoder.editor",
        "label": "Stormcoder"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "stormcoder.editor",
          "group": "navigation@9",
          "when": "editorTextFocus"
        }
      ],
      "stormcoder.editor": [
        {
          "command": "stormcoder.explainSelection",
          "group": "1_ai@1"
        },
        {
          "command": "stormcoder.fixSelection",
          "group": "1_ai@2"
        },
        {
          "command": "stormcoder.editSelection",
          "group": "1_ai@3"
        },
        {
          "command": "stormcoder.docSelection",
          "group": "1_ai@4"
        },
        {
          "command": "stormcoder.optimizeSelection",
          "group": "1_ai@5"
        },
        {
          "command": "stormcoder.generateTests",
          "group": "1_ai@6"
        }
      ],
      "view/title": [
        {
          "command": "stormcoder.newChat",
          "when": "view == stormcoder.view",
          "group": "navigation@1"
        },
        {
          "command": "stormcoder.openSettings",
          "when": "view == stormcoder.view",
          "group": "navigation@2"
        }
      ],
      "scm/inputBox": [
        {
          "command": "stormcoder.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "stormcoder.focus"
        },
        {
          "command": "stormcoder.newChat"
        },
        {
          "command": "stormcoder.openSettings"
        },
        {
          "command": "stormcoder.configureProvider"
        },
        {
          "command": "stormcoder.signIn"
        },
        {
          "command": "stormcoder.clearKey"
        },
        {
          "command": "stormcoder.selectProvider"
        },
        {
          "command": "stormcoder.generateCommitMessage"
        }
      ]
    },
    "keybindings": [
      {
        "command": "stormcoder.completions.trigger",
        "key": "alt+\\",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Stormcoder",
      "properties": {
        "stormcoder.defaultProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "nvidia",
            "gemini",
            "antigravity",
            "openrouter",
            "groq",
            "mistral",
            "cloudflare",
            "kimi",
            "qwen",
            "zai",
            "opencode_zen",
            "xkiro",
            "copilot",
            "grok",
            "kiro",
            "web_gemini",
            "claude-code-cli",
            "custom"
          ],
          "enumDescriptions": [
            "%config.provider.openai%",
            "%config.provider.anthropic%",
            "%config.provider.nvidia%",
            "%config.provider.gemini%",
            "%config.provider.antigravity%",
            "%config.provider.openrouter%",
            "%config.provider.groq%",
            "%config.provider.mistral%",
            "%config.provider.cloudflare%",
            "%config.provider.kimi%",
            "%config.provider.qwen%",
            "%config.provider.zai%",
            "%config.provider.opencode_zen%",
            "%config.provider.xkiro%",
            "%config.provider.copilot%",
            "%config.provider.grok%",
            "%config.provider.kiro%",
            "%config.provider.web_gemini%",
            "%config.provider.claude-code-cli%",
            "%config.provider.custom%"
          ],
          "default": "nvidia",
          "description": "%config.defaultProvider%"
        },
        "stormcoder.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "%config.openai.model%"
        },
        "stormcoder.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "%config.openai.baseUrl%"
        },
        "stormcoder.openai.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.anthropic.model": {
          "type": "string",
          "default": "claude-sonnet-5",
          "description": "%config.anthropic.model%"
        },
        "stormcoder.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com/v1",
          "description": "%config.anthropic.baseUrl%"
        },
        "stormcoder.anthropic.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.anthropic.thinking": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "enumDescriptions": [
            "%config.anthropic.thinking.auto%",
            "%config.anthropic.thinking.off%"
          ],
          "default": "auto",
          "description": "%config.anthropic.thinking%"
        },
        "stormcoder.nvidia.model": {
          "type": "string",
          "default": "meta/llama-3.3-70b-instruct",
          "description": "%config.nvidia.model%"
        },
        "stormcoder.nvidia.baseUrl": {
          "type": "string",
          "default": "https://integrate.api.nvidia.com/v1",
          "description": "%config.nvidia.baseUrl%"
        },
        "stormcoder.nvidia.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.gemini.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "%config.gemini.model%"
        },
        "stormcoder.gemini.baseUrl": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta/openai",
          "description": "%config.gemini.baseUrl%"
        },
        "stormcoder.gemini.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.antigravity.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "%config.antigravity.model%"
        },
        "stormcoder.openrouter.model": {
          "type": "string",
          "default": "deepseek/deepseek-chat-v3-0324:free",
          "description": "%config.openrouter.model%"
        },
        "stormcoder.openrouter.baseUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "%config.openrouter.baseUrl%"
        },
        "stormcoder.openrouter.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.groq.model": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "%config.groq.model%"
        },
        "stormcoder.groq.baseUrl": {
          "type": "string",
          "default": "https://api.groq.com/openai/v1",
          "description": "%config.groq.baseUrl%"
        },
        "stormcoder.groq.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.mistral.model": {
          "type": "string",
          "default": "mistral-medium-latest",
          "description": "%config.mistral.model%"
        },
        "stormcoder.mistral.baseUrl": {
          "type": "string",
          "default": "https://api.mistral.ai/v1",
          "description": "%config.mistral.baseUrl%"
        },
        "stormcoder.mistral.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.cloudflare.accountId": {
          "type": "string",
          "default": "",
          "description": "%config.cloudflare.accountId%"
        },
        "stormcoder.cloudflare.model": {
          "type": "string",
          "default": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
          "description": "%config.cloudflare.model%"
        },
        "stormcoder.cloudflare.baseUrl": {
          "type": "string",
          "default": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
          "description": "%config.cloudflare.baseUrl%"
        },
        "stormcoder.cloudflare.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.kimi.model": {
          "type": "string",
          "default": "kimi-k2.5",
          "description": "%config.kimi.model%"
        },
        "stormcoder.kimi.baseUrl": {
          "type": "string",
          "default": "https://api.moonshot.ai/v1",
          "description": "%config.kimi.baseUrl%"
        },
        "stormcoder.kimi.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.qwen.model": {
          "type": "string",
          "default": "qwen-plus",
          "description": "%config.qwen.model%"
        },
        "stormcoder.qwen.baseUrl": {
          "type": "string",
          "default": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
          "description": "%config.qwen.baseUrl%"
        },
        "stormcoder.qwen.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.zai.model": {
          "type": "string",
          "default": "glm-4.6-flash",
          "description": "%config.zai.model%"
        },
        "stormcoder.zai.baseUrl": {
          "type": "string",
          "default": "https://api.z.ai/api/paas/v4",
          "description": "%config.zai.baseUrl%"
        },
        "stormcoder.zai.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.opencode_zen.model": {
          "type": "string",
          "default": "laguna-s-2.1-free",
          "description": "%config.opencode_zen.model%"
        },
        "stormcoder.opencode_zen.baseUrl": {
          "type": "string",
          "default": "https://opencode.ai/zen/v1",
          "description": "%config.opencode_zen.baseUrl%"
        },
        "stormcoder.opencode_zen.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.xkiro.model": {
          "type": "string",
          "default": "mistralai/mistral-medium-3.5",
          "description": "%config.xkiro.model%"
        },
        "stormcoder.xkiro.baseUrl": {
          "type": "string",
          "default": "https://xkiro.com/v1",
          "description": "%config.xkiro.baseUrl%"
        },
        "stormcoder.xkiro.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.copilot.model": {
          "type": "string",
          "default": "gpt-4.1",
          "description": "%config.copilot.model%"
        },
        "stormcoder.grok.model": {
          "type": "string",
          "default": "grok-4.6",
          "description": "%config.grok.model%"
        },
        "stormcoder.kiro.model": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "%config.kiro.model%"
        },
        "stormcoder.web_gemini.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "%config.web_gemini.model%"
        },
        "stormcoder.webGemini.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.webGemini.enabled%"
        },
        "stormcoder.claude-code-cli.model": {
          "type": "string",
          "default": "",
          "description": "%config.claude-code-cli.model%"
        },
        "stormcoder.claude-code-cli.cliPath": {
          "type": "string",
          "default": "",
          "description": "%config.claude-code-cli.cliPath%"
        },
        "stormcoder.custom.model": {
          "type": "string",
          "default": "llama3.1",
          "description": "%config.custom.model%"
        },
        "stormcoder.custom.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "%config.custom.baseUrl%"
        },
        "stormcoder.custom.authUrl": {
          "type": "string",
          "default": "",
          "description": "%config.authUrl%"
        },
        "stormcoder.agent.maxSteps": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000,
          "description": "%config.agent.maxSteps%"
        },
        "stormcoder.agent.maxContextTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10000000,
          "description": "%config.agent.maxContextTokens%"
        },
        "stormcoder.ask.autoContext": {
          "type": "string",
          "enum": [
            "active",
            "tabs",
            "off"
          ],
          "default": "active",
          "description": "%config.ask.autoContext%"
        },
        "stormcoder.stream.idleTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 0,
          "maximum": 3600000,
          "description": "%config.stream.idleTimeoutMs%"
        },
        "stormcoder.agent.commandTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "maximum": 3600000,
          "description": "%config.agent.commandTimeoutMs%"
        },
        "stormcoder.agent.shell": {
          "type": "string",
          "default": "",
          "description": "%config.agent.shell%"
        },
        "stormcoder.agent.maxSubagents": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 16,
          "description": "%config.agent.maxSubagents%"
        },
        "stormcoder.agent.maxSubagentDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 4,
          "description": "%config.agent.maxSubagentDepth%"
        },
        "stormcoder.agent.maxAgentMessages": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 50,
          "description": "%config.agent.maxAgentMessages%"
        },
        "stormcoder.agent.parallelResearch": {
          "type": "boolean",
          "default": true,
          "description": "%config.agent.parallelResearch%"
        },
        "stormcoder.agent.parallelReads": {
          "type": "boolean",
          "default": true,
          "description": "%config.agent.parallelReads%"
        },
        "stormcoder.agent.maxRunMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "%config.agent.maxRunMinutes%"
        },
        "stormcoder.agent.traceTiming": {
          "type": "boolean",
          "default": false,
          "description": "%config.agent.traceTiming%"
        },
        "stormcoder.remote.traceSessions": {
          "type": "boolean",
          "default": false,
          "description": "%config.remote.traceSessions%"
        },
        "stormcoder.remote.loopback": {
          "type": "boolean",
          "default": false,
          "description": "%config.remote.loopback%"
        },
        "stormcoder.remote.promptEscalationSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "%config.remote.promptEscalationSeconds%"
        },
        "stormcoder.remote.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.remote.enabled%"
        },
        "stormcoder.remote.relayUrl": {
          "type": "string",
          "default": "",
          "description": "%config.remote.relayUrl%"
        },
        "stormcoder.remote.relayMode": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "hosted"
          ],
          "enumDescriptions": [
            "%config.remote.relayMode.auto%",
            "%config.remote.relayMode.local%",
            "%config.remote.relayMode.hosted%"
          ],
          "default": "auto",
          "description": "%config.remote.relayMode%"
        },
        "stormcoder.remote.cloudflaredPath": {
          "type": "string",
          "default": "",
          "description": "%config.remote.cloudflaredPath%"
        },
        "stormcoder.remote.tunnelHostname": {
          "type": "string",
          "default": "",
          "description": "%config.remote.tunnelHostname%"
        },
        "stormcoder.remote.localPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "%config.remote.localPort%"
        },
        "stormcoder.remote.deviceTokenDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 3650,
          "description": "%config.remote.deviceTokenDays%"
        },
        "stormcoder.remote.idleDisableHours": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 8760,
          "description": "%config.remote.idleDisableHours%"
        },
        "stormcoder.remote.approvalFloor": {
          "type": "string",
          "enum": [
            "always",
            "auto-edits",
            "yolo"
          ],
          "enumDescriptions": [
            "%config.guardrails.approval.always%",
            "%config.guardrails.approval.autoEdits%",
            "%config.guardrails.approval.yolo%"
          ],
          "default": "auto-edits",
          "description": "%config.remote.approvalFloor%"
        },
        "stormcoder.rules": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "",
          "description": "%config.rules%"
        },
        "stormcoder.ruleFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".stormcoder/rules.md",
            ".openvs/rules.md",
            "AGENTS.md",
            "CLAUDE.md",
            ".github/copilot-instructions.md",
            ".cursorrules"
          ],
          "description": "%config.ruleFiles%"
        },
        "stormcoder.guardrails.approval": {
          "type": "string",
          "enum": [
            "always",
            "auto-edits",
            "yolo"
          ],
          "enumDescriptions": [
            "%config.guardrails.approval.always%",
            "%config.guardrails.approval.autoEdits%",
            "%config.guardrails.approval.yolo%"
          ],
          "default": "auto-edits",
          "description": "%config.guardrails.approval%"
        },
        "stormcoder.guardrails.deniedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rm\\s+-[a-z]*r[a-z]*f|rm\\s+-[a-z]*f[a-z]*r",
            ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:",
            "\\bmkfs\\b",
            "\\bdd\\s+if=",
            "\\bsudo\\b",
            "git\\s+push\\s+.*(--force|-f)\\b",
            "\\b(curl|wget)\\b[^|]*\\|\\s*(sudo\\s+)?(ba)?sh",
            ">\\s*/dev/sd[a-z]",
            "\\b(shutdown|reboot|halt|poweroff)\\b",
            "chmod\\s+-R\\s+777\\s+/",
            "\\b(rmdir|rd)\\s+(/[a-z]\\s+)*/s\\b",
            "\\bRemove-Item\\b[^|;]*-Recurse[^|;]*-Force|\\bRemove-Item\\b[^|;]*-Force[^|;]*-Recurse",
            "\\bformat\\s+[a-z]:",
            "\\bdel\\s+(/[a-z]\\s+)*/s\\b",
            "rm\\s+-[a-z]*r[a-z]*\\s+(\\S+\\s+)*-[a-z]*f|rm\\s+-[a-z]*f[a-z]*\\s+(\\S+\\s+)*-[a-z]*r|rm\\s+.*--(recursive|force)\\b.*--(force|recursive)\\b",
            "rm\\s+(\\S+\\s+)*(-[a-z]*r[a-z]*|--recursive)\\s+(\\S+\\s+)*(-[a-z]*f[a-z]*|--force)\\b|rm\\s+(\\S+\\s+)*(-[a-z]*f[a-z]*|--force)\\s+(\\S+\\s+)*(-[a-z]*r[a-z]*|--recursive)\\b",
            "\\bgit\\b[^;&|\\n]*\\bpush\\b[^;&|\\n]*(\\s--(force|delete|mirror)\\b|\\s-[a-z]*[fd][a-z]*\\b|\\s\\+\\S|\\s:[^\\s:])",
            "(^|[\\s;&|(])(su|doas|pkexec)\\s+(\\S+\\s+)*?-c\\b|\\b(doas|pkexec)\\b",
            "\\bfind\\b[^;&|\\n]*(\\s-delete\\b|-exec(dir)?\\s+rm\\b)",
            "<\\(\\s*(curl|wget)\\b|\\b(eval|source|(ba|z|da)?sh\\s+-c)\\s+[\"\\']?\\$\\(\\s*(curl|wget)\\b",
            "\\bgit\\b[^;&|\\n]*\\breset\\b[^;&|\\n]*--hard\\b",
            "\\bgit\\b[^;&|\\n]*\\bclean\\b[^;&|\\n]*\\s-[a-z]*f",
            "\\bgit\\b[^;&|\\n]*\\b(checkout|restore)\\b[^;&|\\n]*(\\s--\\s+\\.|\\s\\.\\s*($|[;&|]))",
            "\\bgit\\b[^;&|\\n]*\\bstash\\b[^;&|\\n]*\\b(drop|clear)\\b",
            "\\b(python[0-9.]*|node|nodejs|perl|ruby|php|deno|bun)\\b[^&|\\n]*(rmtree|rmSync|rmdirSync|rm_rf|remove_tree|unlinkSync|shutil\\.rm|rm\\s+-[a-z]*r)",
            "\\b(npm|yarn|pnpm|cargo|twine|gem)\\s+publish\\b|\\btwine\\s+upload\\b",
            "(\\.ssh|\\.aws|\\.gnupg|\\.netrc|\\.npmrc|\\.env\\b|id_rsa|credentials)[^;&\\n]*\\|\\s*(curl|wget|nc|ncat|socat)\\b",
            "\\b(env|printenv|set)\\s*\\|\\s*(curl|wget|nc|ncat|socat)\\b",
            "\\b(curl|wget)\\b[^;&\\n]*(\\s(-d|--data[a-z-]*|-F|--form|--upload-file|-T)\\s*[\\\"']?[\\w.-]*=?@)",
            ">>?\\s*[\\\"']?[^\\s;&|\\\"']*(\\.env(\\.[\\w-]+)?|\\.pem|\\.key|id_rsa|\\.ssh/[^\\s;&|]*|\\.git/[^\\s;&|]*)[\\\"']?(\\s|$|[;&|])",
            "\\btee\\b[^;&|\\n]*(\\.env(\\.[\\w-]+)?|\\.pem|\\.key|id_rsa|\\.ssh/|\\.git/)"

          ],
          "description": "%config.guardrails.deniedCommands%"
        },
        "stormcoder.guardrails.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.guardrails.allowedCommands%"
        },
