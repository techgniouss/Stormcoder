  "scripts": {
    "compile": "gulp compile-extension:openvs-chat",
    "watch": "gulp watch-extension:openvs-chat",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && npm run typecheck-webview",
    "typecheck-webview": "tsc --noEmit --ignoreConfig --allowJs --checkJs --noImplicitAny false --strictNullChecks --target es2022 --lib es2022,dom media/main.js media/prompts.js media/markdown.js media/qr.js media/pairing.js media/webview.d.ts",
    "pretest": "tsc -p ./tsconfig.json",
    "test": "node ./scripts/run-tests.mjs",
    "vscode:prepublish": "npm run build-ext",
    "build-ext": "node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.mjs compile-extension:openvs-chat ./tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/sql.js": "1.4.11"
  }
}
