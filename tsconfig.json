{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2023", "DOM"],
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"noEmit": true,
		"baseUrl": ".",
		"paths": { "vscode": ["host/vscode.ts"] }
	},
	"include": ["src/**/*", "host/**/*", "electron/**/*"]
}
